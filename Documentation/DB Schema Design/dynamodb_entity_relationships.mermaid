erDiagram
    UserProfile {
        string userId
        string email
        string fullName
        string businessName
        string partitaIva
        string codiceFiscale
        string regimeFiscale
        string phone
    }

    Client {
        string clientId
        string userId
        string clientName
        string email
        string phone
        string codiceFiscale
    }

    JobCounter {
        string userId
        int lastJobId
    }

    Job {
        int jobId
        string userId
        string clientId
        string clientName
        string description
        string address
        string targetDate
        string status
    }

    StatusHistory {
        string jobId
        string timestamp
        string fromStatus
        string toStatus
    }

    Quote {
        string jobId
        int totalAmount
        string currency
        string inputText
        int generationTimeMs
        string pdfS3Key
        string status
    }

    QuoteItem {
        string jobId
        int seq
        string description
        int quantity
        string unit
        int unitPrice
        int lineTotal
    }

    Photo {
        string photoId
        string jobId
        string s3Key
        string tag
        string mimeType
        int sizeBytes
        string aiDescription
    }

    Material {
        string materialId
        string jobId
        string itemName
        int quantity
        int cost
        int confidence
        string sourceS3Key
    }

    Invoice {
        string invoiceNumber
        string jobId
        string userId
        string clientName
        int totalAmount
        int vatAmount
        int vatRate
        string status
        string dueDate
        string xmlS3Key
    }

    InvoiceItem {
        string jobId
        int seq
        string description
        int quantity
        string unit
        int unitPrice
        int lineTotal
    }

    MonthlyAnalytics {
        string userId
        string month
        int totalRevenue
        int jobsCreated
        int jobsCompleted
        int totalMaterialCost
    }

    NotificationLog {
        string userId
        string timestamp
        string type
        string channel
        string status
        int ttl
    }

    UserProfile ||--|| JobCounter : owns
    UserProfile ||--o{ Client : manages
    UserProfile ||--o{ Job : creates
    UserProfile ||--o{ MonthlyAnalytics : aggregates
    UserProfile ||--o{ NotificationLog : receives
    Client ||--o{ Job : assigns
    Job ||--o{ StatusHistory : tracks
    Job ||--o{ Quote : generates
    Quote ||--o{ QuoteItem : contains
    Job ||--o{ Photo : documents
    Job ||--o{ Material : logs
    Job ||--o{ Invoice : produces
    Invoice ||--o{ InvoiceItem : contains
