{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": false
  },
  "include": [
    "server.ts",
    "adapter.ts",
    "backend/handlers/jobs.handler.ts",
    "backend/shared/dynamodb.ts",
    "backend/shared/s3.ts",
    "backend/shared/anthropic.ts",
    "backend/shared/response.ts",
    "backend/shared/logger.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
